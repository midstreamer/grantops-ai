# Application
APP_NAME=GrantOps AI
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# Database (SQLite for local development)
DATABASE_URL=sqlite:///./grantops.db

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OpenAlex (optional — API works without a key for light usage)
# OPENALEX_API_KEY=

# LLM (optional — required for AI summary generation)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=

# Google Sheets / Docs export (service account)
# Enable Google Sheets API, Google Docs API, and Google Drive API in GCP.
# Share spreadsheets with the service account email (Editor) for Sheets export.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id

# Optional: route discovery workflow through Google ADK (requires google-adk; see docs/adk_setup.md)
# USE_ADK_ORCHESTRATOR=false
